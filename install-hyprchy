#!/usr/bin/env bash
#INSTAL-HYPRCHY
#
# Estructura del repo esperada (ver README):
#   common/           dotfiles compartidos entre todas las máquinas
#   hosts/<hostname>/  overrides puntuales de esta máquina (mismo layout
#                       relativo que common/, ej: hosts/cloca-not/.config/hypr/monitors.lua)
# El hostname se detecta con `hostnamectl --static`. Todo se symlinkea
# archivo por archivo — un host puede overridear un solo archivo sin
# duplicar el resto del directorio que lo contiene.
#
# Uso:
#   ./install-hyprchy                # instalación normal
#   ./install-hyprchy --atomic-bin   # además, symlinkea ~/.local/bin y
#                                     # ~/.local/share/omarchy/bin enteros a
#                                     # /usr/local/bin (red de seguridad para
#                                     # cuando algo lanzado por uwsm-app no
#                                     # encuentra un binario propio). Podés
#                                     # re-correr el script solo con esta flag
#                                     # en cualquier momento, es idempotente.

set -e

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colores
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

info()    { echo -e "${GREEN}[+]${NC} $1"; }
warning() { echo -e "${YELLOW}[!]${NC} $1"; }
error()   { echo -e "${RED}[x]${NC} $1"; }
section() { echo -e "\n${CYAN}━━━ $1 ━━━${NC}"; }

ask_yes_no() {
    local answer
    read -rp "$(echo -e "${YELLOW}?${NC} $1 [s/N]: ")" answer
    [[ "$answer" =~ ^[sSyY]$ ]]
}

if [ "$EUID" -eq 0 ]; then
    error "No corras esto como root/sudo directamente. makepkg (para compilar paru)"
    error "se niega a correr como root. Corré: ./install-hyprchy"
    exit 1
fi

# ──────────────────────────────────────────────
# Dependencias (definidas en dependencies, al lado de este script)
# ──────────────────────────────────────────────

DEPENDENCIES_FILE="$DOTFILES_DIR/dependencies"

if [ ! -f "$DEPENDENCIES_FILE" ]; then
    error "No encuentro $DEPENDENCIES_FILE"
    error "Ese archivo tiene las listas PACMAN_DEPS / AUR_DEPS / CACHYOS_DEPS."
    exit 1
fi

# shellcheck source=dependencies
source "$DEPENDENCIES_FILE"

# ──────────────────────────────────────────────
# paru
# ──────────────────────────────────────────────
#
# Se instala ACÁ, no en install-all, porque:
#   - si el repo [cachyos] está disponible, paru se instala como paquete
#     normal de ese repo (ya viene compilado y sano, es el camino rápido)
#   - si no está disponible, hay que compilarlo de fuente sí o sí. Usamos
#     'paru' (fuente, vía AUR) y NO 'paru-bin' (precompilado) — paru-bin
#     viene linkeado contra el libalpm.so.<N> del sistema del mantenedor en
#     el momento de compilarlo, y en distros con pacman de build git/dev
#     (como CachyOS) el soname de libalpm cambia seguido, dejando paru-bin
#     roto con "error while loading shared libraries: libalpm.so.N: cannot
#     open shared object file" sin arreglo posible salvo esperar una build
#     nueva en el AUR. 'paru' fuente compila contra el libalpm real del
#     sistema en el momento de instalarlo, así que no tiene ese problema.

install_paru() {
    section "paru"

    if command -v paru &>/dev/null; then
        info "paru ya está instalado."
        return
    fi

    if grep -q "^\[cachyos\]" /etc/pacman.conf 2>/dev/null; then
        info "Repo [cachyos] detectado, instalando paru desde ahí."
        sudo pacman -S --needed --noconfirm paru
    else
        warning "Repo [cachyos] no encontrado. Compilando paru desde fuente (AUR)..."
        sudo pacman -S --needed --noconfirm base-devel git

        local build_dir
        build_dir="$(mktemp -d)"
        git clone --depth=1 https://aur.archlinux.org/paru.git "$build_dir/paru"
        (cd "$build_dir/paru" && makepkg -si --noconfirm)
        rm -rf "$build_dir"
    fi

    if command -v paru &>/dev/null; then
        info "paru instalado correctamente."
    else
        error "paru no quedó instalado. Revisá el output de arriba y reintentá a mano."
        exit 1
    fi
}

install_pacman_deps() {
    section "Instalando dependencias (pacman)"

    local missing=()
    for pkg in "${PACMAN_DEPS[@]}"; do
        if ! pacman -Qi "$pkg" &>/dev/null; then
            missing+=("$pkg")
        fi
    done

    if [ ${#missing[@]} -eq 0 ]; then
        info "Todas las dependencias pacman ya están instaladas."
    else
        info "Paquetes a instalar: ${missing[*]}"
        sudo pacman -S --needed "${missing[@]}"
    fi
}

install_aur_deps() {
    section "Instalando dependencias (AUR)"

    if ! command -v paru &>/dev/null; then
        error "paru no encontrado. Algo falló en install_paru() más arriba."
        exit 1
    fi

    local missing=()
    for pkg in "${AUR_DEPS[@]}"; do
        if ! pacman -Qi "$pkg" &>/dev/null; then
            missing+=("$pkg")
        fi
    done

    if [ ${#missing[@]} -eq 0 ]; then
        info "Todas las dependencias AUR ya están instaladas."
    else
        info "Paquetes AUR a instalar: ${missing[*]}"
        warning "Ojo: esto baja bastantes paquetes del AUR (repositorio de usuarios, no oficial)."
        warning "Si alguno cuelga la instalación (conexión, falla al compilar, etc),"
        warning "comentalo con # en dependencies, volvé a correr este script, e instalalo"
        warning "después a mano con: paru -S <paquete>"
        paru -S --needed --noconfirm --skipreview "${missing[@]}"
    fi
}

install_cachyos_deps() {
    section "Instalando dependencias (CachyOS)"

    if ! grep -q "^\[cachyos\]" /etc/pacman.conf 2>/dev/null; then
        warning "Repo de CachyOS no encontrado en pacman.conf."
        warning "Estos paquetes no se van a instalar: ${CACHYOS_DEPS[*]}"
        warning "Sin walker el launcher no va a funcionar."
        warning "Seguí la guía en https://wiki.cachyos.net/installation/repos/ para agregarlo,"
        warning "o instalá walker desde AUR: paru -S walker-bin"
        return
    fi

    local missing=()
    for pkg in "${CACHYOS_DEPS[@]}"; do
        if ! pacman -Qi "$pkg" &>/dev/null; then
            missing+=("$pkg")
        fi
    done

    if [ ${#missing[@]} -eq 0 ]; then
        info "Todas las dependencias CachyOS ya están instaladas."
    else
        info "Paquetes CachyOS a instalar: ${missing[*]}"
        sudo pacman -S --needed "${missing[@]}"
    fi
}

# ──────────────────────────────────────────────
# PATH — dos mecanismos, cada uno cubre un contexto distinto:
#   - shell rc: para shells interactivas (terminal local, SSH)
#   - ~/.config/uwsm/env: para todo lo que arranca DENTRO de la sesión
#     gráfica vía uwsm-app/systemd --user (waybar, binds, autostart). NO es
#     redundante con lo de arriba — ~/.config/environment.d/ NO sirve para
#     esto porque systemd tiene un bug/limitación conocida donde PATH
#     específicamente se ignora ahí (ver systemd/systemd#12259). uwsm lee
#     este archivo con su propio mecanismo, no el generador de systemd.
# ──────────────────────────────────────────────

setup_path() {
    section "Configurando PATH (shell interactiva)"

    local shell_rc=""
    if [[ "$SHELL" == *"fish"* ]]; then
        shell_rc="$HOME/.config/fish/config.fish"
        local path_line="fish_add_path \$HOME/.local/bin"
    elif [[ "$SHELL" == *"zsh"* ]]; then
        shell_rc="$HOME/.zshrc"
        local path_line='export PATH="$HOME/.local/bin:$PATH"'
    else
        shell_rc="$HOME/.bashrc"
        local path_line='export PATH="$HOME/.local/bin:$PATH"'
    fi

    if grep -q "\.local/bin" "$shell_rc" 2>/dev/null; then
        info "PATH ya configurado en $shell_rc"
    else
        echo "$path_line" >> "$shell_rc"
        info "PATH agregado a $shell_rc"
        warning "Reiniciá la shell o ejecutá: source $shell_rc"
    fi
}

setup_uwsm_env() {
    section "Configurando ~/.config/uwsm/env (PATH para la sesión gráfica)"

    mkdir -p "$HOME/.config/uwsm"
    local env_file="$HOME/.config/uwsm/env"

    if grep -q "OMARCHY_PATH" "$env_file" 2>/dev/null; then
        info "$env_file ya tiene OMARCHY_PATH configurado."
    else
        cat >> "$env_file" << 'EOF'
export OMARCHY_PATH=$HOME/.local/share/omarchy
export PATH="$HOME/.local/bin:$OMARCHY_PATH/bin:$PATH"
EOF
        info "$env_file actualizado."
        warning "Esto solo lo lee uwsm al arrancar la sesión gráfica — hace falta"
        warning "logout/login completo (no alcanza con hyprctl reload) para que tome efecto."
    fi
}

setup_xdg_terminal() {
    section "Configurando terminal default para xdg-terminal-exec"

    mkdir -p "$HOME/.config"
    local list_file="$HOME/.config/xdg-terminals.list"

    if [ -f "$list_file" ]; then
        info "$list_file ya existe, no lo piso."
        return
    fi

    cat > "$list_file" << 'EOF'
Alacritty.desktop
kitty.desktop
EOF
    info "$list_file configurado (Alacritty como default, kitty como fallback)."
    warning "Ajustá el orden/contenido si usás otro terminal — xdg-terminal-exec usa"
    warning "el primero de la lista que tenga un .desktop instalado."
}

# ──────────────────────────────────────────────
# Symlinks
# ──────────────────────────────────────────────

symlink() {
    local src="$1"
    local dst="$2"

    if [ -L "$dst" ]; then
        rm "$dst"
    elif [ -e "$dst" ]; then
        warning "Ya existe (no es symlink): $dst → haciendo backup en ${dst}.bak"
        mv "$dst" "${dst}.bak"
    fi

    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    info "$dst → $src"
}

HOSTNAME_ID="$(hostnamectl --static 2>/dev/null || hostname)"
COMMON_DIR="$DOTFILES_DIR/common"
HOST_DIR="$DOTFILES_DIR/hosts/$HOSTNAME_ID"

# Symlinkea, archivo por archivo (no directorio por directorio), todo lo que
# haya bajo $src_root replicando la misma estructura relativa dentro de
# $HOME. Al ser por archivo individual, un host puede overridear UN SOLO
# archivo (ej: .config/hypr/monitors.lua, .local/bin/waybar-cpu-watts) sin
# tener que duplicar el resto del directorio que lo contiene.
symlink_tree() {
    local src_root="$1"
    local label="$2"

    if [ ! -d "$src_root" ]; then
        return
    fi

    section "Symlinks ($label)"
    while IFS= read -r -d '' src_file; do
        local rel_path="${src_file#"$src_root"/}"
        symlink "$src_file" "$HOME/$rel_path"
    done < <(find "$src_root" \( -type f -o -type l \) -print0)
}

create_symlinks() {
    if [ ! -d "$COMMON_DIR" ]; then
        error "No encuentro $COMMON_DIR — ¿el repo no tiene la estructura common/hosts?"
        exit 1
    fi

    # Orden importa: primero common/ (la base), después hosts/<hostname>/
    # ENCIMA (gana, porque symlink() reemplaza el symlink si ya existe).
    symlink_tree "$COMMON_DIR" "common"
    symlink_tree "$HOST_DIR" "override: $HOSTNAME_ID"

    if [ ! -d "$HOST_DIR" ]; then
        warning "No hay overrides para este host ('$HOSTNAME_ID') en hosts/."
        warning "Usando solo common/ — puede que falten cosas específicas de esta"
        warning "máquina (monitores, waybar-cpu-watts/waybar-gpu con paths de hwmon"
        warning "propios, etc). Si hace falta, creá hosts/$HOSTNAME_ID/ con los"
        warning "archivos puntuales que difieran (misma estructura relativa que common/)."
    fi
}

# Unidades de systemd --user que vienen con el repo (ej: swayosd-server.service).
# El symlink de ~/.local/share/omarchy de arriba las hace visibles DENTRO de
# ese árbol, pero systemd --user busca en ~/.config/systemd/user/ — hace
# falta este segundo symlink explícito, uno por unidad.
symlink_systemd_units() {
    section "Symlinks de unidades systemd --user"

    local units_dir="$HOME/.local/share/omarchy/config/systemd/user"
    if [ ! -d "$units_dir" ]; then
        warning "No encontré $units_dir, salteando unidades systemd."
        return
    fi

    mkdir -p "$HOME/.config/systemd/user"
    local found=false
    for unit in "$units_dir"/*; do
        [ -e "$unit" ] || continue
        found=true
        name="$(basename "$unit")"
        symlink "$unit" "$HOME/.config/systemd/user/$name"
    done

    if [ "$found" = true ]; then
        systemctl --user daemon-reload
        info "systemd --user recargado."
    fi
}

# walker.desktop tiene que estar en ~/.config/autostart/ para que el
# generador de systemd (xdg-desktop-autostart-generator) le arme la unidad
# transitoria app-walker@autostart.service solo. Sin este symlink, walker
# nunca termina de arrancar bien y omarchy-restart-walker falla.
symlink_autostart_entries() {
    section "Symlinks de autostart XDG"

    local walker_desktop="$HOME/.local/share/omarchy/default/walker/walker.desktop"
    if [ -f "$walker_desktop" ]; then
        mkdir -p "$HOME/.config/autostart"
        symlink "$walker_desktop" "$HOME/.config/autostart/walker.desktop"
    else
        warning "No encontré walker.desktop en el repo, salteando."
    fi
}

# elephant (backend de walker) no se habilita symlinkeando un .service — trae
# su propio subcomando que genera y habilita su unidad.
enable_elephant() {
    section "Habilitando elephant (backend de walker)"

    if ! command -v elephant &>/dev/null; then
        warning "elephant no está instalado, salteando."
        return
    fi

    if systemctl --user is-enabled elephant.service &>/dev/null; then
        info "elephant.service ya está habilitado."
    else
        elephant service enable
        info "elephant.service habilitado."
    fi
}

# Symlinks "atómicos" a /usr/local/bin — red de seguridad opcional. No
# reemplaza a setup_uwsm_env (que es la forma correcta), pero cubre el caso
# de emergencia donde algo lanzado por uwsm-app no encuentra un binario
# propio y no da tiempo/ganas de averiguar por qué. Seleccionable con
# --atomic-bin, re-corrible en cualquier momento.
atomic_bin_symlinks() {
    section "Symlinks atómicos a /usr/local/bin (red de seguridad)"

    for dir in "$HOME/.local/bin" "$HOME/.local/share/omarchy/bin"; do
        if [ -d "$dir" ] && [ -n "$(ls -A "$dir" 2>/dev/null)" ]; then
            sudo ln -sf "$dir"/* /usr/local/bin/
            info "Symlinkeado: $dir/* → /usr/local/bin/"
        else
            warning "$dir vacío o inexistente, salteando."
        fi
    done
}

# ──────────────────────────────────────────────
# Avisos post-instalación
# ──────────────────────────────────────────────

post_install_notes() {
    section "Notas post-instalación"

    echo -e "${YELLOW}Atención — configuración manual requerida:${NC}"
    echo ""
    echo "  1. waybar-cpu-watts usa paths de hwmon hardcodeados."
    echo "     Verificá que sean correctos en tu hardware:"
    echo "       /sys/class/hwmon/hwmon3/energy9_input  (energía CPU)"
    echo "       /sys/class/hwmon/hwmon4/temp1_input    (temperatura CPU)"
    echo "     Usá 'ls /sys/class/hwmon/' y 'cat /sys/class/hwmon/hwmon*/name'"
    echo "     para identificar los correctos."
    echo ""
    echo "  2. waybar-gpu usa ROCm (AMD)."
    echo "     Si el hardware es distinto ajustá el script manualmente."
    echo ""
    echo "  3. linux-wallpaperengine requiere Wallpaper Engine instalado en Steam."
    echo "     Sin eso el script no funciona, pero no rompe nada al iniciar."
    echo "     Podés descomentar la 6ta línea del autostart para que se lance swaybg."
    echo "     Deberías instalar swaybg si no lo tenés."
    echo "     Aun así, de estas dotfiles se eliminó el handler de fondos, buena suerte."
    echo ""
    if [[ " $* " != *" --atomic-bin "* ]]; then
        echo "  4. Si algo lanzado por uwsm-app (binds, waybar, autostart) tira"
        echo "     'command not found' para un binario en ~/.local/bin o"
        echo "     ~/.local/share/omarchy/bin, corré:"
        echo "         ./install-hyprchy --atomic-bin"
        echo "     Symlinkea esos binarios también a /usr/local/bin como red de seguridad."
    fi
}

# ──────────────────────────────────────────────
# Main
# ──────────────────────────────────────────────

main() {
    echo -e "${CYAN}"
    echo "  ┌─────────────────────────────┐"
    echo "  │     dotfiles installer      │"
    echo "  └─────────────────────────────┘"
    echo -e "${NC}"

    install_cachyos_deps
    install_paru
    install_pacman_deps
    install_aur_deps
    setup_path
    setup_uwsm_env
    setup_xdg_terminal
    create_symlinks
    symlink_systemd_units
    symlink_autostart_entries
    enable_elephant

    if [[ " $* " == *" --atomic-bin "* ]]; then
        atomic_bin_symlinks
    fi

    post_install_notes "$@"

    echo ""
    info "Instalación completa."
}

main "$@"
