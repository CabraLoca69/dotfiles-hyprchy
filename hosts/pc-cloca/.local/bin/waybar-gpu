#!/bin/bash
CACHE=/tmp/waybar-gpu-paths

if [ -f "$CACHE" ]; then
    source "$CACHE"
fi

if [ -z "$GPU_HWMON" ] || [ ! -d "$GPU_HWMON" ]; then
    GPU_HWMON=$(grep -l amdgpu /sys/class/hwmon/hwmon*/name | head -1 | xargs dirname)
    echo "GPU_HWMON=\"$GPU_HWMON\"" > "$CACHE"
fi

GPU_USE=$(cat "$GPU_HWMON/device/gpu_busy_percent")
GPU_WATTS=$(awk '{printf "%.0f", $1/1000000}' "$GPU_HWMON/power1_average")
GPU_TEMP=$(awk '{printf "%.0f", $1/1000}' "$GPU_HWMON/temp1_input")

if [ "$GPU_USE" -ge 80 ]; then
    CLASS="high"
elif [ "$GPU_USE" -ge 50 ]; then
    CLASS="medium"
else
    CLASS="low"
fi

echo "{\"text\": \"${GPU_USE}% ${GPU_WATTS}W 󰹑\", \"class\": \"${CLASS}\", \"tooltip\": \"GPU temp: ${GPU_TEMP}°C\"}"