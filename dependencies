# Listas de paquetes que instala install.sh. Separado en su propio archivo
# para poder comentar una línea puntual sin tocar la lógica del instalador,
# por si algún paquete cuelga la instalación (conexión, mirror caído, el
# paquete AUR no compila, etc).
#
# Para saltear un paquete: comentalo con # y volvé a correr ./install.sh.
# Podés instalarlo después a mano (sudo pacman -S <paquete> o paru -S <paquete>)
# una vez que resuelvas lo que lo estaba colgando.

PACMAN_DEPS=(
    # ── Core: Hyprland y compositor (NO opcional, todo lo demás depende de esto) ──
    uwsm
    hyprland
    hyprlock
    hypridle
    hyprsunset
    hyprpicker
    xdg-desktop-portal-hyprland
    xdg-desktop-portal-gtk
    qt5-wayland
    qt6-wayland
    kitty

    # ── Core: barra, notificaciones, audio ──
    waybar
    mako
    playerctl
    pamixer
    wireplumber
    wl-clipboard

    # ── Opcional: utilidades de terminal / shell (comentá lo que no uses) ──
    calcurse         # lo usa la waybar
    gum              # usado para omarchy-tz-select, se puede sacar.
    fzf              # lo usa el gestor de wallpapers
    jq               
    bat
    eza
    starship
    zoxide
    fastfetch

    # ── Opcional: terminal alternativa ──
    alacritty

    # ── Opcional: archivos, capturas, wallpaper ──
    nautilus
    gvfs-mtp
    grim
    slurp
    swaybg

    # ── Core: auth/keyring (sin esto, apps GUI piden contraseña seguido) ──
    polkit-gnome
    gnome-keyring
    libsecret

    # ── Opcional: utilidades varias de sistema/hardware ──
    bluetui
    impala
    chafa
    brightnessctl
    swayosd
    wiremix

    # ── Core: fuentes (iconos de waybar/walker dependen de la nerd font) ──
    noto-fonts
    noto-fonts-emoji
    ttf-jetbrains-mono-nerd
)

AUR_DEPS=(
    elephant-all                          # backend de walker, core
    xdg-terminal-exec                     # core, lo usan varios binds
    sunwait                               # usado por hyprsunset-daynight
    hyprland-preview-share-picker-git     # picker de share, opcional si no usás screen-share con preview
    yaru-icon-theme                       # opcional, cosmético
    linux-wallpaperengine-git             # opcional, solo si tenés Wallpaper Engine en Steam
)

CACHYOS_DEPS=(
    paru                                    #necesario para instalar paquetes del AUR
    walker                                  #necesario, sin esto no tenes menus
)