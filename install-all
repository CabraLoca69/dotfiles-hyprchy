#!/usr/bin/env bash
# INSTALL-ALL
# corre toda la secuencia de instalación de punta a punta:
#   1. install-hyprchy  (paru, deps pacman/AUR/CachyOS, PATH, symlinks de dotfiles)
#   2. install-drivers  (CPU/GPU)
#   3. bootstrap-system (multilib, servicios, grupos, keyring, display manager)
#
# Se corre UNA vez en una instalación nueva. Es re-corrible sin problema:
# cada script y cada paso ya es idempotente (chequea antes de instalar/tocar nada).
#
# Uso:
#   ./install-all
#
# Asume que install-hyprchy, install-drivers y bootstrap-system están
# en el mismo directorio que este script (es decir, en la raíz del repo
# de dotfiles). Si no es así, pasalos por variable de entorno:
#   INSTALL_SH=/otra/ruta/install-hyprchy ./install-all

set -e

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

info()    { echo -e "${GREEN}[+]${NC} $1"; }
warning() { echo -e "${YELLOW}[!]${NC} $1"; }
error()   { echo -e "${RED}[x]${NC} $1"; }
section() { echo -e "\n${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  $1\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

INSTALL_SH="${INSTALL_SH:-$SCRIPT_DIR/install-hyprchy}"
DRIVERS_SH="${DRIVERS_SH:-$SCRIPT_DIR/install-drivers}"
BOOTSTRAP_SH="${BOOTSTRAP_SH:-$SCRIPT_DIR/bootstrap-system}"

if [ "$EUID" -eq 0 ]; then
    error "No corras esto como root directamente (ni con sudo por delante)."
    error "Los scripts internos ya usan sudo donde hace falta, y paru/AUR necesitan"
    error "compilar como usuario normal. Corré: ./install-all"
    exit 1
fi

for f in "$INSTALL_SH" "$DRIVERS_SH" "$BOOTSTRAP_SH"; do
    if [ ! -f "$f" ]; then
        error "No encuentro $f"
        error "Pasá la ruta correcta con INSTALL_SH / DRIVERS_SH / BOOTSTRAP_SH."
        exit 1
    fi
    chmod +x "$f"
done

# ──────────────────────────────────────────────
# sudo: pedir la contraseña una sola vez y mantenerla viva
# ──────────────────────────────────────────────
keep_sudo_alive() {
    info "Pidiendo contraseña de sudo (una sola vez, se mantiene viva durante toda la instalación)."
    sudo -v

    # Refresca el timestamp cada 60s en background para que no expire
    # a mitad de una instalación larga (AUR compilando, etc).
    ( while true; do sudo -n true; sleep 60; kill -0 "$$" 2>/dev/null || exit; done ) &
    SUDO_KEEPALIVE_PID=$!
}

stop_sudo_keepalive() {
    if [ -n "${SUDO_KEEPALIVE_PID:-}" ]; then
        kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
    fi
}

# ──────────────────────────────────────────────
# Main
# ──────────────────────────────────────────────
ask_yes_no() {
    local answer
    read -rp "$(echo -e "${YELLOW}?${NC} $1 [s/N]: ")" answer
    [[ "$answer" =~ ^[sSyY]$ ]]
}

main() {
    echo -e "${CYAN}"
    echo "  ┌─────────────────────────────────────┐"
    echo "  │   install-all: instalación total     │"
    echo "  └─────────────────────────────────────┘"
    echo -e "${NC}"

    warning "Esto instala paquetes, symlinkea dotfiles, instala drivers de CPU/GPU y"
    warning "configura servicios del sistema. Una vez confirmado corre todo solo,"
    warning "sin volver a preguntar (salvo las cuestiones de seguridad en bootstrap-system:"
    warning "autologin, [multilib], PAM keyring)."
    if ! ask_yes_no "¿Instalar ahora?"; then
        info "Cancelado."
        exit 0
    fi
    
    keep_sudo_alive
    trap stop_sudo_keepalive EXIT

    section "Paso 1: dotfiles (paru + deps + symlinks) — $INSTALL_SH"
    "$INSTALL_SH" "$@"

    section "Paso 2: drivers de CPU/GPU — $DRIVERS_SH"
    "$DRIVERS_SH"

    section "Paso 3: bootstrap del sistema (servicios, DM, etc) — $BOOTSTRAP_SH"
    "$BOOTSTRAP_SH"

    section "Listo"
    info "Los 3 pasos terminaron. Se recomienda reiniciar ahora:"

    echo "    sudo reboot"
}

main "$@"
