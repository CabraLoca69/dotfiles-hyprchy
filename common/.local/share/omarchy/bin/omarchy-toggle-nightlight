#!/bin/bash
if systemctl --user is-active --quiet hyprsunset-daynight.service; then
    systemctl --user stop hyprsunset-daynight.service
    hyprsunset -t 6000
    notify-send -u low "   Nightlight automático desactivado"
else
    systemctl --user start hyprsunset-daynight.service
    notify-send -u low "  Nightlight automático activado"
fi